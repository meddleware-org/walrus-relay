{
  "name": "@meddleware/walrus-relay",
  "version": "0.1.31",
  "description": "Shared Vue 3 UI for the Walrus upload relay: relay selection + tip estimation, NFT-gate access, and a blob-upload widget. Built on @meddleware/walrus-client + @meddleware/access-gate-client.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/walrus-relay.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.36.0",
    "@mysten/walrus": "~1.2.35",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.9",
    "@meddleware/design-tokens": "^0.1.10",
    "@meddleware/ui": "^0.1.31",
    "@meddleware/walrus-client": "^0.0.28"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@meddleware/eslint-config": "^0.0.2",
    "@mysten/sui": "^2.36.0",
    "@mysten/walrus": "~1.2.35",
    "@playwright/test": "~1.64.1",
    "@types/node": "~24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "html-validate": "^11.16.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "~5.0.4",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
